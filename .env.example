# Orca-MTF Configuration & Environment Variables

# AI Studio / Google Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Base Application URL
APP_URL="https://orca-mtf.pages.dev"

# Database (PostgreSQL / Supabase / Neon / Cloudflare Hyperdrive)
# Optional — in-memory mock activates automatically when unset
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Redis Cache (Optional — in-memory cache activates automatically when unset)
REDIS_URL="redis://default:password@host:6379"

# JWT Secret for Auth sessions
JWT_SECRET="orca-mtf-jwt-secret-min-32-chars-key"

# VN Stock Provider (VNDirect / VNStock optional credentials)
VNSTOCK_BASE_URL=""
VNSTOCK_API_KEY=""

# Cloudflare Deployment Environment Variables
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production
